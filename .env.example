# Copy to .env.local and fill in. Restart `npm run dev` after editing.
NEYSA_BASE_URL=
NEYSA_API_KEY=
NEYSA_MODEL=gemma-4-26-b-a4-b-it
SARVAM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
SERPAPI_API_KEY=
# Optional switches: LLM=openai to try OpenAI first, ASR=..., DATA_MODE=dummy

# Host dashboard (Supabase: Project Settings > API). Run supabase/schema.sql once first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails that see the admin claims queue
ADMIN_EMAILS=
